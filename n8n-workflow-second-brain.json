    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "=You are an AI assistant for a \"Second Brain\" application. Analyze the following text and provide:\n1. A concise, descriptive title (max 100 characters)\n2. A brief summary (2-3 sentences)\n3. The most appropriate category from: Inbox, Notes, Gratitude, Archive, or suggest a new one\n4. The item type: 'link', 'note', or 'idea'\n5. Up to 5 relevant tags\n\nText to analyze:\n{{ $('Process Item Webhook').item.json.body.input }}\n\nRespond in this exact JSON format:\n{\n  \"title\": \"...\",\n  \"summary\": \"...\",\n  \"category\": \"...\",\n  \"item_type\": \"...\",\n  \"tags\": [\"tag1\", \"tag2\"]\n}"
            }
          ]
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "ai-categorize-text",
      "name": "AI Categorize (Text)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [680, 400],
      "credentials": {
        "openAiApi": {
          "id": "openai",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and format for frontend\nconst aiResponse = $input.first().json.message?.content || $input.first().json.text;\n\ntry {\n  // Try to parse as JSON\n  let parsed;\n  \n  // Handle markdown code blocks\n  const jsonMatch = aiResponse.match(/```json\\n?([\\s\\S]*?)\\n?```/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[1]);\n  } else {\n    parsed = JSON.parse(aiResponse);\n  }\n  \n  return {\n    title: parsed.title || 'Untitled',\n    summary: parsed.summary || '',\n    category: parsed.category || 'Inbox',\n    item_type: parsed.item_type || 'note',\n    tags: parsed.tags || [],\n    url: $('Process Item Webhook').item.json.body.input.startsWith('http') \n      ? $('Process Item Webhook').item.json.body.input \n      : undefined\n  };\n} catch (e) {\n  // Fallback if JSON parsing fails\n  return {\n    title: $('Process Item Webhook').item.json.body.input.substring(0, 100),\n    summary: '',\n    category: 'Inbox',\n    item_type: 'note',\n    tags: [],\n    url: undefined\n  };\n}"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
